  "itemProps": {
    "id": { "type": "value", "from": "property_id", "strict": true },
    "address": { "type": "value", "search": true, "from": "address" },
    "postcode": {
      "type": "value",
      "uri": "postcode:",
      "search": true,
      "from": "postcode"
    },
    "borough": {
      "type": "vocab",
      "uri": "borough:",
      "filter": true,
      "from": "borough"
    },
    "licence_type": {
      "type": "vocab",
      "uri": "lt:",
      "titleUri": "ui:licence_type",
      "from": "licence_type",
      "filter": true,
      "nullable": true
    },
    "managing_agent_name": {
      "type": "vocab",
      "uri": "man:",
      "titleUri": "ui:managing_agent_name",
      "from": "managing_agent_name",
      "filter": true,
      "nullable": true
    },
    "managing_agent_address": {
      "type": "value",
      "from": "managing_agent_address",
      "search": true,
      "nullable": true
    },
    "licence_holder_name": {
      "type": "vocab",
      "uri": "lhn:",
      "titleUri": "ui:licence_holder_name",
      "from": "licence_holder_name",
      "filter": true,
      "nullable": true
    },
    "licence_start_date": {
      "type": "value",
      "from": "licence_start_date",
      "nullable": true
    },
    "licence_end_date": {
      "type": "value",
      "from": "licence_end_date",
      "nullable": true
    },
    "lat": {
      "type": "value",
      "as": "number",
      "from": "latitude"
    },
    "lng": {
      "type": "value",
      "as": "number",
      "from": "longitude"
    }
  },
  "popup": {
    "titleProp": "address",
    "leftPaneWidth": "70%",
    "leftPane": [
      {
        "itemProp": "borough",
        "valueStyle": "text",
        "showLabel": true
      }
    ],
    "topRightPane": [
      { "itemProp": "licence_type", "valueStyle": "text", "showLabel": true },
      {
        "itemProp": "licence_holder_name",
        "valueStyle": "text",
        "showLabel": true
      },
      {
        "itemProp": "licence_start_date",
        "valueStyle": "text",
        "showLabel": true
      },
      {
        "itemProp": "licence_end_date",
        "valueStyle": "text",
        "showLabel": true
      }
    ],
    "bottomRightPane": [
      {
        "itemProp": "managing_agent_name",
        "valueStyle": "text",
        "showLabel": true
      },
      {
        "itemProp": "managing_agent_address",
        "valueStyle": "text",
        "showLabel": true
      }
    ]
  }
