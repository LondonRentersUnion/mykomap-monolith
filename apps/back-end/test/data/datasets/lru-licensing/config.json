    },
    "lic_type": {
      "en": {
        "title": "License Types",
        "terms": {
          "Selective_licence": "Selective licence",
          "Mandatory_HMO_licence": "Mandatory HMO Licence",
          "Additional_HMO_licence": "Additional HMO Licence"
        }
      }
    }
  },
  "itemProps": {
    "id": { "type": "value", "from": "property_id", "strict": true },
    "address": { "type": "value", "search": true, "from": "address" },
    "postcode": {
      "type": "value",
      "uri": "postcode:",
      "search": true,
      "filter": true,
      "from": "postcode"
    },
    "borough": {
      "type": "vocab",
      "uri": "borough:",
      "filter": true,
      "from": "borough"
    },
    "licence_type": {
      "type": "vocab",
      "uri": "lic_type:",
      "from": "licence_type",
      "filter": true
    },
    "managing_agent_name": {
      "type": "value",
      "from": "managing_agent_name",
      "search": true,
      "filter": true
    },
    "licence_holder_name": {
      "type": "value",
      "uri": "lic_holder:",
      "from": "licence_holder_name",
      "search": true,
      "filter": true
    },
    "licence_end_date": {
      "type": "value",
      "from": "licence_end_date",
      "filter": true
    },
    "lat": {
      "type": "value",
      "as": "number",
      "from": "latitude"
    },
    "lng": {
      "type": "value",
      "as": "number",
      "from": "longitude"
    }
  },
  "popup": {
    "titleProp": "address",
    "leftPaneWidth": "70%",
    "leftPane": [
      {
        "itemProp": "address",
        "valueStyle": "text",
        "showLabel": true
      },
      {
        "itemProp": "borough",
        "valueStyle": "text",
        "showLabel": true
      }
    ],
    "topRightPane": [
      { "itemProp": "licence_type", "valueStyle": "text", "showLabel": true }
    ],
    "bottomRightPane": [
      {
        "itemProp": "licence_holder_name",
        "valueStyle": "text",
        "showLabel": true
      },
      {
        "itemProp": "managing_agent_name",
        "valueStyle": "text",
        "showLabel": true
      }
    ]
  }
